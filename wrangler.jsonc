{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "charlestoncaves",
  "account_id": "b750824d7f77ea68f5630ba69e740894",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "assets": {"directory": "./dist", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "charlestoncaves-inquiries", "database_id": "98c51018-972d-4500-ade0-fdc9fb39c892"}],
  "ratelimits": [{"name": "INQUIRY_LIMITER", "namespace_id": "1037", "simple": {"limit": 5, "period": 60}}],
  "observability": {"enabled": true}
}
